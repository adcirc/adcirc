##############################################################################
# x86-64_Intel:	Linux using the Intel oneAPI (IntelLLVM) compilers, as used
#               by the ADCIRC CircleCI Intel builds
##############################################################################
F90_SER = ifx
F90_OMP = ifx
F90_MPI = mpif90
FLAGS_OPT = -O0
FLAGS_MSC = -w -assume byterecl -traceback -diag-disable 8291 -diag-disable 8293
FLAGS90_MSC = $(FLAGS_MSC)
FLAGS_SER =
FLAGS_OMP = -qopenmp
FLAGS_MPI =
INCS_SER =
INCS_OMP =
INCS_MPI =
LIBS_SER =
LIBS_OMP =
LIBS_MPI =
O_DIR = ../../work/odir4/
OUT = -o
EXTO = o
MAKE = make
RM = rm -f
swch = -unix -impi
